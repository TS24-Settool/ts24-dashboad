# ============================================================
# TS24 Dashboard — .gitignore
# NEVER commit files containing API keys or credentials
# ============================================================

# ── Secrets & credentials (NEVER commit these) ──────────────
ts24_config.json
.streamlit/secrets.toml
*.env
.env
*.key
*.pem
secrets.json
config.local.json
*_secret*
*_private*

# ── Streamlit local config ───────────────────────────────────
.streamlit/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.pytest_cache/

# ── Database & data files ────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Data files (large / sensitive) ──────────────────────────
*.xlsx
*.csv
*.xls
*.xlsm

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editor ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Claude Code system files ─────────────────────────────────
*.skill

# ── 一時比較ファイル（Streamlitが書き込む、commitしない）────────
lap_comparison_latest.json

# ── Quality Gate runtime evidence (local, may contain sensitive paths) ──
.gate/

# ── Apply/wiring backup snapshots（実行時アーティファクト・commitしない）──
_backup_*/

# ── 生成済み Report v2 出力（PPTX/PDF・大容量・派生物）────────────
reports/pptx/
